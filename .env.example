# --- PostgreSQL (cổng 54329: DB nhúng của `npm run local`, hoặc Docker) ---
DB_OWNER_PASSWORD=doi_mat_khau_owner
APP_RW_PASSWORD=doi_mat_khau_rw
APP_RO_PASSWORD=doi_mat_khau_ro

# Chạy migration (tài khoản chủ sở hữu schema)
MIGRATE_DATABASE_URL=postgresql://khaosat_owner:doi_mat_khau_owner@localhost:54329/khaosat
# Ứng dụng và worker (không có quyền DDL)
DATABASE_URL=postgresql://app_rw:doi_mat_khau_rw@localhost:54329/khaosat
# Chỉ đọc (xuất báo cáo, công cụ phân tích)
DATABASE_URL_RO=postgresql://app_ro:doi_mat_khau_ro@localhost:54329/khaosat
# pg-boss tự tạo schema `pgboss` nên cần quyền DDL: dùng tài khoản owner
PGBOSS_DATABASE_URL=postgresql://khaosat_owner:doi_mat_khau_owner@localhost:54329/khaosat

# --- Bí mật (tạo bằng: openssl rand -base64 32) ---
HASH_SECRET=doi_gia_tri_nay_toi_thieu_16_ky_tu   # khóa HMAC băm mã người học, GIỮ NGOÀI DB, đổi là mất khả năng phát hiện trùng
AUTH_SECRET=doi_gia_tri_nay_toi_thieu_16_ky_tu

# --- Lưu trữ file (Excel gốc, báo cáo đã xuất) ---
STORAGE_DIR=./storage

# --- Đăng nhập ---
# true = vào thẳng hệ thống, không cần đăng nhập (tạm thời khi phát triển). Đặt false để bật lại.
AUTH_DISABLED=true
# Bật đăng nhập nhanh bằng email có trong bảng app_user (CHỈ dùng khi phát triển)
ENABLE_DEV_LOGIN=true
# SSO (tùy chọn)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# --- Seed ban đầu ---
SEED_FIRST_YEAR=2024-2025              # năm học bắt đầu áp dụng quy tắc
SEED_ADMIN_EMAIL=admin@truong.edu.vn
SEED_ADMIN_NAME=Quản trị hệ thống
SEED_ADMIN_PASSWORD=Admin@123     # mật khẩu ban đầu của admin; đổi ngay sau lần đăng nhập đầu
