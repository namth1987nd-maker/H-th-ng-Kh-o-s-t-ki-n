{
  "name": "khao-sat",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=20.11" },
  "scripts": {
    "local": "npm install --no-audit --no-fund && dotenv -e .env -- tsx scripts/dev-local.mts",
    "start:all": "npm run local",
    "start:docker": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "worker": "dotenv -e .env -- tsx src/jobs/worker.ts",
    "db:migrate": "dotenv -e .env -- node-pg-migrate -m db/migrations -j sql -d MIGRATE_DATABASE_URL up",
    "db:migrate:down": "dotenv -e .env -- node-pg-migrate -m db/migrations -j sql -d MIGRATE_DATABASE_URL down",
    "db:seed": "dotenv -e .env -- tsx scripts/seed.ts",
    "db:codegen": "dotenv -e .env -- kysely-codegen --url \"$MIGRATE_DATABASE_URL\" --out-file src/lib/db/generated.ts",
    "test": "vitest run src",
    "test:db": "dotenv -v RUN_DB_TESTS=1 -- vitest run tests/db",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docxtemplater": "^3.60.0",
    "docxtemplater-image-module-free": "^1.1.1",
    "exceljs": "^4.4.0",
    "kysely": "^0.28.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "next-auth": "^5.0.0-beta.29",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.5",
    "pizzip": "^3.1.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testcontainers/postgresql": "^11.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv-cli": "^8.0.0",
    "embedded-postgres": "latest",
    "kysely-codegen": "^0.18.0",
    "node-pg-migrate": "^7.9.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "react-is": "^19.1.0"
  }
}
